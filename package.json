  },
  "homepage": "https://github.com/Mediaeater/Hudson_Street_Library#readme",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "axios": "^1.9.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.4.5",
    "dotenv": "^17.2.0",
    "glob": "^11.0.3",
    "slugify": "^1.6.6"
  },
