{
  "name": "hudson_street_library",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm:watch:css\" \"eleventy --serve\"",
    "build": "npm run build:css && eleventy",
    "build:books": "node scripts/generators/generate-book-pages.js",
    "build:css": "tailwindcss -i src/assets/css/input.css -o _site/assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/assets/css/input.css -o _site/assets/css/tailwind.css --watch",
    "clean": "rm -rf _site",
    "deploy:check": "./scripts/check-deployment.sh",
    "test": "npm run test:csv && mocha",
    "test:csv": "node scripts/validate-csv-robust.js",
    "test:unit": "mocha test/unit/**/*.js",
    "test:integration": "mocha test/integration/**/*.js",
    "test:watch": "mocha --watch",
    "test:verbose": "mocha --reporter tap",
    "test:coverage": "nyc mocha",
    "test:coverage:report": "nyc report --reporter=text-lcov > coverage/lcov.info",
    "test:coverage:html": "nyc mocha && open coverage/index.html",
    "setup:hooks": "bash scripts/setup-git-hooks.sh",
    "add": "node scripts/add-book-from-text.js --interactive",
    "add:file": "node scripts/add-book-from-text.js --file",
    "cleanup": "npm run cleanup:logs && npm run cleanup:temp && npm run cleanup:build",
    "cleanup:logs": "find . -name '*.log' -not -path './node_modules/*' -not -path './_site/*' -delete",
    "cleanup:temp": "rm -rf temp-processing incoming-images",
    "cleanup:build": "rm -rf _site",
    "prebuild": "npm run cleanup",
    "deploy": "./scripts/deploy-manual.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mediaeater/Hudson_Street_Library.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mediaeater/Hudson_Street_Library/issues"
  },
  "homepage": "https://github.com/Mediaeater/Hudson_Street_Library#readme",
  "description": "",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "autoprefixer": "^10.5.0",
    "axios": "^1.16.1",
    "chai": "^4.5.0",
    "concurrently": "^9.2.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.4.5",
    "dotenv": "^17.2.0",
    "fast-xml-parser": "^5.5.9",
    "glob": "^11.0.3",
    "mocha": "^11.7.6",
    "node-cache": "^5.1.2",
    "nyc": "^17.1.0",
    "postcss": "^8.5.14",
    "slugify": "^1.6.9",
    "tailwindcss": "^3.4.18",
    "validator": "^13.15.35"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2"
  }
}
