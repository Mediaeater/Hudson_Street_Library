# Hudson Street Library - .gitignore
# This file specifies intentionally untracked files that Git should ignore
# See: https://git-scm.com/docs/gitignore

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# root 
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Environment variables
.env
.env.local
.env.production.local
.env.development.local
.env.test.local

# Credentials and secrets
credentials.json
*credentials*.json
!*credentials.example.json
*secret*
*key*
!*example*key*
*token*
!*example*token*

# API keys and config
api-keys/
config.local.json
config.prod.json

# Claude settings
.claude/
**/.claude/settings.local.json

# CMS sensitive data
cms/.env
cms/import-scripts/google-sheets/credentials.json
cms/import-scripts/google-sheets/.env
cms/data/database/
cms/uploads/

# Node modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Backup files
*.backup
*.bak
*.orig

# Operating System
Thumbs.db
ehthumbs.db
Desktop.ini

# Package manager lock files (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# ESLint cache
.eslintcache

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file variations
.env.backup
.env.*.local

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Legacy directories (migrated to src/)
imgs/
cms/

# Log directories
logs/
scripts/logs/

# Temporary processing directories
incoming-images/
temp-processing/

# Generated files
*.generated.*
auto-generated-*

# Test files (if any)
.coverage/
.jest/

# Deployment artifacts
*.tar.gz
*.zip

# Local development overrides
config.local.*
settings.local.*

# Database files (SQLite)
*.db
*.db-shm
*.db-wal
data/*.db
data/*.db-shm
data/*.db-wal

# Database backups
*.db.backup-*
data/*.db.backup-*

# Migration reports
data/migration_report_*.json

# Test databases
test_*.db
data/test_*.db

# CSV backups
src/_data/*_backup_migration_*.csv

# Backups directory
backups/

# Test output directories
scripts/test-output/
