#!/bin/sh
# Pre-commit hook to validate the catalogue before commit

# Check if any catalogue file (books.csv, src/_data/catalog/*.csv) or the wing
# registry is being committed. The validator checks every file plus the
# cross-file rules (37 columns, unique ids, id blocks).
if git diff --cached --name-only | grep -qE '^src/_data/(books\.csv|catalog/[^/]+\.csv|wings\.json)$'; then
  echo "📋 Validating catalogue CSV structure..."

  # Run the robust validator
  node scripts/validate-csv-robust.js

  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ CSV validation failed!"
    echo "   The CSV has structural errors that must be fixed before committing."
    echo ""
    echo "To fix:"
    echo "  1. Run: node scripts/fix-csv-formatting.js src/_data/books.csv src/_data/books_fixed.csv"
    echo "  2. Run: node scripts/validate-csv-robust.js"
    echo "  3. If valid: cp src/_data/books_fixed.csv src/_data/books.csv"
    echo "  4. Try committing again"
    echo ""
    exit 1
  fi

  echo "✅ CSV validation passed"

  # Book count must never decrease (see scripts/check-book-count-monotonic.js)
  node scripts/check-book-count-monotonic.js || exit 1
fi

# Design system invariants — one green, one header. Source-level only, so it
# needs no build and stays fast. The _site coverage check runs in CI.
if git diff --cached --name-only | grep -qE '\.(css|njk|html)$'; then
  node scripts/validate-design-system.js --source || exit 1
fi

# Scan staged changes for secrets
echo "🔒 Scanning staged changes for secrets..."
if ! gitleaks git --pre-commit --staged --redact --no-banner; then
  echo ""
  echo "❌ Secret scan failed! A potential secret was found in staged changes."
  echo "   Review the finding above. If it's a false positive, add it to .gitleaksignore."
  exit 1
fi
echo "✅ No secrets detected"

exit 0
