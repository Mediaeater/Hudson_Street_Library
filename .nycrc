{
  "all": true,
  "include": [
    "scripts/utils/*.js"
  ],
  "exclude": [
    "test/**",
    "coverage/**",
    ".mocharc.json"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "check-coverage": false,
  "lines": 80,
  "statements": 80,
  "functions": 80,
  "branches": 80,
  "cache": true,
  "sourceMap": true,
  "instrument": true
}
