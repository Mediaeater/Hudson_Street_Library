#!/usr/bin/env bash

# Pre-commit hook that runs tests before allowing commits
# This hook is opt-in. Install with: npm run setup:hooks
# To bypass temporarily: git commit --no-verify

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the root directory of the git repository
GIT_ROOT=$(git rev-parse --show-toplevel)
cd "$GIT_ROOT"

echo ""
echo -e "${BLUE}Running pre-commit checks...${NC}"
echo ""

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
  echo -e "${YELLOW}Warning: node_modules not found. Run 'npm install' first.${NC}"
  exit 1
fi

# Run tests
echo -e "${BLUE}Running tests...${NC}"
echo ""

if npm test; then
  echo ""
  echo -e "${GREEN}✓ All tests passed${NC}"
  echo -e "${GREEN}✓ Commit allowed${NC}"
  echo ""
  exit 0
else
  echo ""
  echo -e "${RED}✗ Tests failed${NC}"
  echo ""
  echo -e "${YELLOW}Fix the failing tests before committing.${NC}"
  echo -e "${YELLOW}To commit anyway, use: git commit --no-verify${NC}"
  echo ""
  exit 1
fi
