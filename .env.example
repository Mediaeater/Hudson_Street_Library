# Hudson Street Library Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Google Books API Key (FREE)
# Get your key at: https://console.cloud.google.com
# Enable the "Books API" and create an API key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# DPLA API Key (FREE)
# Register at: https://dp.la/developers
DPLA_API_KEY=your-dpla-api-key

# Europeana API Key (FREE)
# Register at: https://pro.europeana.eu/page/apis
EUROPEANA_API_KEY=your-europeana-api-key

# LibraryThing API Key (FREE for non-commercial use)
# Apply at: https://www.librarything.com/services/keys.php
LIBRARY_THING_API_KEY=your-library-thing-api-key