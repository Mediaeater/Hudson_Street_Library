{#
  Site Footer Component
  Parameters:
  - siteName: Override default site name (optional)
  - description: Override default description (optional)
#}

{% set defaultSiteName = "HUDSON STREET LIBRARY" %}
{% set defaultDescription = "A specialized photography book collection in Manhattan's West Village." %}

<footer class="bg-neutral-900 text-neutral-300 py-16">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row justify-between pb-12 border-b border-neutral-700">
            <!-- Site Info -->
            <div class="mb-8 md:mb-0">
                <h3 class="text-2xl font-bold mb-4 text-white">
                    {{ siteName or defaultSiteName }}
                </h3>
                <p class="text-neutral-400 max-w-xs">
                    {{ description or defaultDescription }}
                </p>
            </div>
            
            <!-- Footer Navigation -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
                <!-- Explore Section -->
                <div>
                    <h4 class="font-semibold text-lg mb-4 text-neutral-100">Explore</h4>
                    <ul class="space-y-2 text-neutral-400">
                        <li><a href="/index.html" class="hover:text-white">Home</a></li>
                        <li><a href="/index.html#about" class="hover:text-white">About</a></li>
                        <li><a href="/collection-explore.html" class="hover:text-white">Collections</a></li>
                        <li><a href="/index.html#publications" class="hover:text-white">Publications</a></li>
                        <li><a href="/news.html" class="hover:text-white">News</a></li>
                        <li><a href="/index.html#contact" class="hover:text-white">Contact</a></li>
                    </ul>
                </div>
                
                <!-- Visit Section -->
                <div>
                    <h4 class="font-semibold text-lg mb-4 text-neutral-100">Visit</h4>
                    <ul class="space-y-2 text-neutral-400">
                        <li><a href="/index.html#contact" class="hover:text-white">Visit Policy</a></li>
                        <li><a href="/index.html#contact" class="hover:text-white">Location</a></li>
                        <li><a href="/index.html#contact" class="hover:text-white">Appointments</a></li>
                    </ul>
                </div>
                
                <!-- Connect Section -->
                <div>
                    <h4 class="font-semibold text-lg mb-4 text-neutral-100">Connect</h4>
                    <ul class="space-y-2 text-neutral-400">
                        <li><a href="#" class="hover:text-white">Instagram</a></li>
                        <!-- Add more social links as needed -->
                    </ul>
                </div>
            </div>
        </div>
        
        <!-- Copyright -->
        <div class="pt-12 text-center text-neutral-500 text-sm">
            <p>© <span class="copyright-year">{{ "now" | date("Y") }}</span> {{ siteName or defaultSiteName }}. All rights reserved.</p>
        </div>
    </div>
</footer>