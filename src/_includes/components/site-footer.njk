{#
  Site Footer Component
  Parameters:
  - siteName: Override default site name (optional)
#}

{% set defaultSiteName = "HUDSON STREET LIBRARY" %}

<footer class="bg-neutral-900 text-white py-12">
    <div class="container mx-auto px-6 text-center">
        <h3 class="text-xl font-bold tracking-tight mb-6">
            {{ siteName or defaultSiteName }}
        </h3>
        <p class="text-neutral-400 text-sm">
            © 2025 {{ siteName or defaultSiteName }}. All rights reserved.
        </p>
    </div>
</footer>