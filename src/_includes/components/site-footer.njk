{#
  Site Footer Component
  Parameters:
  - siteName: Override default site name (optional)
  - description: Override default description (optional)
#}

{% set defaultSiteName = "HUDSON STREET LIBRARY" %}
{% set defaultDescription = "A curated collection of art, photography, zines, and ephemera, privately held in a former printing house in New York's West Village." %}

<footer class="bg-neutral-900 text-neutral-300 py-16">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between pb-12 border-b border-neutral-700">
            <!-- Site Info -->
            <div class="mb-8 md:mb-0">
                <h3 class="text-2xl font-bold mb-4 text-white">
                    {{ siteName or defaultSiteName }}
                </h3>
                <p class="text-neutral-400 max-w-xs">
                    {{ description or defaultDescription }}
                </p>
            </div>

            <!-- Footer Navigation - Horizontal Layout -->
            <nav class="flex flex-wrap gap-x-8 gap-y-4">
                <a href="/" class="text-white hover:text-teal-300 visited:text-white transition-colors">Home</a>
                <a href="/#about" class="text-white hover:text-teal-300 visited:text-white transition-colors">About</a>
                <a href="/collection-explore.html" class="text-white hover:text-teal-300 visited:text-white transition-colors">Collections</a>
                <a href="/static-demo/" class="text-white hover:text-teal-300 visited:text-white transition-colors">Search</a>
                <a href="/#publications" class="text-white hover:text-teal-300 visited:text-white transition-colors">Publications</a>
                <a href="/news/" class="text-white hover:text-teal-300 visited:text-white transition-colors">News</a>
                <a href="/#contact" class="text-white hover:text-teal-300 visited:text-white transition-colors">Contact</a>
            </nav>
        </div>

        <!-- Copyright -->
        <div class="pt-12 text-center text-neutral-500 text-sm">
            <p>© <span class="copyright-year">2024</span> {{ siteName or defaultSiteName }}. All rights reserved.</p>
        </div>
    </div>
</footer>