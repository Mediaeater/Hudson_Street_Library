{#
  Site Footer Component
  Parameters:
  - siteName: Override default site name (optional)
#}

{% set defaultSiteName = "Hudson Street Library" %}

<footer class="bg-neutral-50 border-t border-neutral-200 mt-24 py-12">
    <div class="container mx-auto px-6 text-center text-neutral-600">
        {# Preflight is off site-wide, so an <a> with no colour class falls back
           to the UA default blue. Every link needs one stated explicitly. #}
        <p>© 2026 {{ siteName or defaultSiteName }} · <a href="/identity/" class="text-neutral-600 underline hover:text-neutral-900">Identity</a> · <a href="/colophon.html" class="text-neutral-600 underline hover:text-neutral-900">Colophon</a></p>
    </div>
</footer>