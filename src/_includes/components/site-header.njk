{#
  Site Header Component
  Canonical header for all pages - ensures consistent navigation across the site.

  Parameters:
  - currentPage: Used for active navigation highlighting (optional)
    Values: 'about', 'collections', 'search', 'publications', 'news', 'recently-added', 'contact'

  Typography is set explicitly below so the header renders identically
  regardless of the host page's body font.
#}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;600;700&family=Crimson+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    .site-header {
        font-family: 'Crimson Pro', Georgia, serif;
    }
    .site-header .site-logo {
        font-family: 'Crimson Pro', Georgia, serif;
        font-weight: 700;
        letter-spacing: 0.01em;
    }
    .site-header .nav-link {
        font-family: 'Crimson Pro', Georgia, serif;
        font-size: 1.0625rem;
        font-weight: 400;
        letter-spacing: 0.005em;
    }
    .site-header .nav-link[aria-current="page"],
    .site-header .nav-link-active {
        font-weight: 600;
    }
    .site-header #mobile-nav-menu a {
        font-family: 'Crimson Pro', Georgia, serif;
        font-size: 1.0625rem;
    }
</style>

<header class="site-header sticky top-0 z-10 bg-white/95 backdrop-blur-sm border-b border-black/8">
    <div class="mx-auto max-w-6xl px-6 py-4">
        <div class="flex items-center justify-between">
            <!-- Logo/Site Title -->
            <a href="/" class="site-logo text-xl sm:text-2xl font-bold tracking-tight text-teal-900" style="text-decoration: none;">
                HUDSON STREET LIBRARY
            </a>

            <!-- Desktop Navigation -->
            <nav id="main-nav" class="hidden md:flex items-center gap-1">
                <a href="/#about"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'about' }}">
                   About
                </a>
                <a href="/collection-explore.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'collections' }}">
                   Collections
                </a>
                <a href="/static-demo/"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'search' }}">
                   Search
                </a>
                <a href="/#publications"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'publications' }}">
                   Publications
                </a>
                <a href="/news.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'news' }}">
                   News
                </a>
                <a href="/collections/recently_added.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'recently-added' }}">
                   Recently Added
                </a>
                <a href="/discover.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'discover' }}">
                   Discover
                </a>
                <a href="/#contact"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'contact' }}">
                   Contact
                </a>
            </nav>

            <!-- Mobile Menu Button -->
            <!-- Icons are inline SVGs (not Font Awesome) so the menu works on
                 every page, including those that do not load an icon font. -->
            <button class="md:hidden focus:outline-none text-teal-800 p-1 -mr-1"
                    aria-label="Toggle menu"
                    aria-controls="mobile-nav-menu"
                    aria-expanded="false"
                    onclick="toggleMobileMenu()">
                <svg id="mobile-menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg id="mobile-menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <nav id="mobile-nav-menu"
         class="hidden md:hidden absolute top-full left-0 right-0 bg-white shadow-lg px-6 py-4 space-y-1 z-40">
        <a href="/#about" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">About</a>
        <a href="/collection-explore.html" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Collections</a>
        <a href="/static-demo/" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Search</a>
        <a href="/#publications" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Publications</a>
        <a href="/news.html" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">News</a>
        <a href="/collections/recently_added.html" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Recently Added</a>
        <a href="/discover.html" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Discover</a>
        <a href="/#contact" class="block py-2 px-3 rounded text-neutral-700 hover:bg-teal-50 hover:text-teal-900">Contact</a>
    </nav>
</header>

<script>
function toggleMobileMenu() {
    const menu = document.getElementById('mobile-nav-menu');
    const button = document.querySelector('button[aria-controls="mobile-nav-menu"]');
    const openIcon = document.getElementById('mobile-menu-icon-open');
    const closeIcon = document.getElementById('mobile-menu-icon-close');
    const willOpen = menu.classList.contains('hidden');

    menu.classList.toggle('hidden', !willOpen);
    menu.classList.toggle('flex', willOpen);
    menu.classList.toggle('flex-col', willOpen);
    if (openIcon) openIcon.classList.toggle('hidden', willOpen);
    if (closeIcon) closeIcon.classList.toggle('hidden', !willOpen);
    if (button) button.setAttribute('aria-expanded', String(willOpen));
}
</script>
