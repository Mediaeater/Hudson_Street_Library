{#
  Site Header Component
  Canonical header for all pages - ensures consistent navigation across the site.

  Parameters:
  - currentPage: Used for active navigation highlighting (optional)
    Values: 'about', 'collections', 'search', 'publications', 'news', 'recently-added', 'contact'

  Typography is set explicitly below so the header renders identically
  regardless of the host page's body font.
#}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@400;600;700&family=Crimson+Pro:wght@300;400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&display=swap" rel="stylesheet">

<style>
    .site-header {
        font-family: 'Literata', Georgia, serif;
    }
    .site-header .site-logo {
        font-family: 'Crimson Pro', Georgia, serif;
        font-weight: 700;
        letter-spacing: 0.01em;
    }
    .site-header .nav-link {
        font-family: 'Literata', Georgia, serif;
        font-size: 1.0625rem;
        font-weight: 400;
        letter-spacing: 0.005em;
    }
    .site-header .nav-link[aria-current="page"],
    .site-header .nav-link-active {
        font-weight: 600;
    }
    .site-header #mobile-nav-menu a {
        font-family: 'Literata', Georgia, serif;
        font-size: 1.0625rem;
    }
    /* Nav label alternates between "Recent" and "Catalogued" — both words
       stack in one grid cell (width = longest word) and crossfade on an
       8s cycle, half-phase apart. Static "Recent" when reduced motion. */
    .site-header .nav-cycle {
        display: inline-grid;
        text-align: center;
    }
    .site-header .nav-cycle > span {
        grid-area: 1 / 1;
        animation: nav-cycle-fade 8s infinite;
    }
    .site-header .nav-cycle > span:nth-child(2) {
        animation-delay: -4s;
    }
    @keyframes nav-cycle-fade {
        0%, 40%  { opacity: 1; }
        50%, 90% { opacity: 0; }
        100%     { opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
        .site-header .nav-cycle > span { animation: none; }
        .site-header .nav-cycle > span:nth-child(2) { opacity: 0; }
    }

    /*
      Mobile menu uses self-contained, component-scoped CSS rather than
      Tailwind utilities, so its layout can't be broken by global stylesheet
      changes. This originally fixed an invisible-sliver bug: design-system.css
      ships an unlayered `* { padding: 0 }` reset that beats Tailwind's layered
      utilities and collapsed the old icon-only button. The self-contained
      styling is kept deliberately.
    */
    .site-header .menu-toggle { display: none; }
    .site-header .mobile-nav { display: none; }

    @media (max-width: 767px) {
        .site-header .menu-toggle {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.7rem;
            border: 1px solid rgba(36, 61, 35, 0.3);
            border-radius: 0.5rem;
            background: #ffffff;
            color: #243d23;
            cursor: pointer;
            line-height: 1;
        }
        .site-header .menu-toggle:hover { background: #f0f5f0; }
        .site-header .menu-toggle:focus-visible {
            outline: 2px solid #243d23;
            outline-offset: 2px;
        }
        .site-header .menu-toggle svg {
            width: 22px;
            height: 22px;
            display: block;
            flex-shrink: 0;
        }
        .site-header .menu-toggle .menu-toggle-label {
            font-family: 'Literata', Georgia, serif;
            font-weight: 600;
            font-size: 0.8rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
        .site-header .menu-toggle .icon-close { display: none; }
        .site-header .menu-toggle[aria-expanded="true"] .icon-open { display: none; }
        .site-header .menu-toggle[aria-expanded="true"] .icon-close { display: block; }

        .site-header .mobile-nav.is-open {
            display: flex;
            flex-direction: column;
        }
        .site-header .mobile-nav {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #ffffff;
            border-top: 1px solid rgba(0, 0, 0, 0.08);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
            padding: 0.5rem;
            z-index: 40;
        }
        .site-header .mobile-nav a {
            display: block;
            padding: 0.75rem 1rem;
            border-radius: 0.375rem;
            color: #404040;
            text-decoration: none;
        }
        .site-header .mobile-nav a:hover {
            background: #f0f5f0;
            color: #1b2e1a;
        }
    }
</style>

<header class="site-header sticky top-0 z-10 bg-white/95 backdrop-blur-sm border-b border-black/8">
    <div class="mx-auto max-w-6xl px-6 py-4">
        <div class="flex items-center justify-between">
            <!-- Logo/Site Title -->
            <a href="/" class="site-logo text-xl sm:text-2xl font-bold tracking-tight text-teal-900" style="text-decoration: none;">
                HUDSON STREET LIBRARY
            </a>

            <!-- Desktop Navigation -->
            <nav id="main-nav" class="hidden md:flex items-center gap-1">
                <a href="/#about"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'about' }}">
                   About
                </a>
                <a href="/collection-explore.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'collections' }}">
                   Collections
                </a>
                <a href="/static-demo/"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'search' }}">
                   Search
                </a>
                <a href="/#publications"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'publications' }}">
                   Publications
                </a>
                <a href="/news.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'news' }}">
                   News
                </a>
                <a href="/collections/recently_added.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'recently-added' or currentPage == 'recently-catalogued' }}">
                   <span class="nav-cycle" aria-label="Recent"><span aria-hidden="true">Recent</span><span aria-hidden="true">Catalogued</span></span>
                </a>
                <a href="/discover.html"
                   class="nav-link {{ 'nav-link-active' if currentPage == 'discover' }}">
                   Discover
                </a>
            </nav>

            <!-- Mobile Menu Button -->
            <!-- Icon + visible "Menu" label so the control is obvious on mobile.
                 Sizing/visibility come from the unlayered styles above, not
                 Tailwind utilities (see note in the <style> block). Icons are
                 inline SVGs so the menu works on pages without an icon font. -->
            <button class="menu-toggle"
                    aria-label="Toggle menu"
                    aria-controls="mobile-nav-menu"
                    aria-expanded="false"
                    onclick="toggleMobileMenu()">
                <svg class="icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg class="icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <span class="menu-toggle-label">Menu</span>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <nav id="mobile-nav-menu" class="mobile-nav" aria-label="Mobile navigation">
        <a href="/#about">About</a>
        <a href="/collection-explore.html">Collections</a>
        <a href="/static-demo/">Search</a>
        <a href="/#publications">Publications</a>
        <a href="/news.html">News</a>
        <a href="/collections/recently_catalogued.html">Recently Catalogued</a>
        <a href="/collections/recently_added.html">Recently Added</a>
        <a href="/discover.html">Discover</a>
    </nav>
</header>

<script>
function toggleMobileMenu() {
    const menu = document.getElementById('mobile-nav-menu');
    const button = document.querySelector('button[aria-controls="mobile-nav-menu"]');
    const willOpen = !menu.classList.contains('is-open');

    menu.classList.toggle('is-open', willOpen);
    // Icon swap (hamburger <-> X) is driven by aria-expanded in CSS.
    if (button) button.setAttribute('aria-expanded', String(willOpen));
}
</script>
