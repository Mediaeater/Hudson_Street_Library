{#
  Enhanced Book Thumbnail Component with XSS protection and fallbacks
  Usage: {% include "components/book-thumbnail.njk", book: bookData, size: "medium" %}
  Parameters:
  - book: Book object from CSV
  - size: "small", "medium", "large" (optional, defaults to medium)
  - className: Additional CSS classes (optional)
#}

{% set thumbnailSize = size or 'medium' %}
{% set bookTitle = book.Title or book.title or 'Untitled' %}
{% set bookAuthor = (book['Author, First'] + ' ' + book['Author, Last']) if book['Author, First'] or book['Author, Last'] else (book.author or '') %}
{% set imageField = book.Image or book.cover_image %}
{% set bookISBN = book.ISBN or book.isbn_asin or '' %}

{% if thumbnailSize == 'small' %}
  {% set containerClass = 'w-20 h-24' %}
  {% set iconSize = 'text-lg' %}
  {% set titleSize = 'text-xs' %}
{% elif thumbnailSize == 'large' %}
  {% set containerClass = 'w-48 h-64' %}
  {% set iconSize = 'text-4xl' %}
  {% set titleSize = 'text-sm' %}
{% else %}
  {% set containerClass = 'w-32 h-40' %}
  {% set iconSize = 'text-2xl' %}
  {% set titleSize = 'text-xs' %}
{% endif %}

<div class="book-thumbnail group {{ className or '' }}">
  <div class="relative {{ containerClass }} bg-gray-200 rounded-lg overflow-hidden shadow-md group-hover:shadow-lg transition-shadow">
    <img class="thumbnail-image w-full h-full object-cover" 
         alt="Cover of {{ bookTitle | escape }}"
         data-title="{{ bookTitle | escape }}"
         data-author="{{ bookAuthor | escape }}"
         data-isbn="{{ bookISBN | escape }}"
         data-image-field="{{ imageField | escape }}"
         style="display:none;"
         onload="this.style.display='block'; this.nextElementSibling.style.display='none';"
         onerror="showThumbnailPlaceholder(this)">
    <!-- Placeholder shown initially and on error -->
    <div class="thumbnail-placeholder w-full h-full flex flex-col items-center justify-center text-gray-500 bg-gray-100 p-2">
      <i class="fas fa-book {{ iconSize }} mb-1"></i>
      <p class="{{ titleSize }} text-center leading-tight px-1">{{ bookTitle | escape | truncate(25) }}</p>
      {% if bookAuthor %}
        <p class="text-xs text-gray-400 mt-1 text-center">{{ bookAuthor | escape | truncate(20) }}</p>
      {% endif %}
    </div>
  </div>
  
  {% if showMeta != false %}
    <div class="mt-2 px-1">
      <h3 class="{{ titleSize }} font-medium text-gray-900 leading-tight line-clamp-2">{{ bookTitle | escape }}</h3>
      {% if bookAuthor %}
        <p class="text-xs text-gray-600 mt-1">{{ bookAuthor | escape }}</p>
      {% endif %}
    </div>
  {% endif %}
</div>

<script>
// Generate cover path using our acquisition naming convention
function generateThumbnailCoverPath(img) {
  const imageField = img.dataset.imageField;
  const title = img.dataset.title;
  const author = img.dataset.author;
  const isbn = img.dataset.isbn;
  
  // If there's an existing image field, try that first
  if (imageField && imageField.trim() && imageField !== 'null') {
    return `/assets/images/books/${imageField}`;
  }
  
  // Generate path from our acquired covers
  if (isbn && isbn !== 'NULL' && isbn !== '' && isbn !== 'null') {
    const cleanAuthor = author.replace(/[^a-zA-Z0-9.-]/g, '_');
    const cleanTitle = title.replace(/[^a-zA-Z0-9.-]/g, '_');
    const cleanISBN = isbn.replace(/[^a-zA-Z0-9.-]/g, '_');
    const coverFileName = `${cleanAuthor}_${cleanTitle}_${cleanISBN}`.replace(/_+/g, '_').replace(/^_|_$/g, '').substring(0, 100) + '.jpg';
    return `/assets/images/books/${coverFileName}`;
  }
  
  return null;
}

function showThumbnailPlaceholder(img) {
  img.style.display = 'none';
  const placeholder = img.nextElementSibling;
  if (placeholder && placeholder.classList.contains('thumbnail-placeholder')) {
    placeholder.style.display = 'flex';
  }
}

// Initialize thumbnail images when DOM loads
document.addEventListener('DOMContentLoaded', function() {
  const thumbnailImages = document.querySelectorAll('.thumbnail-image');
  
  thumbnailImages.forEach(function(img) {
    const coverPath = generateThumbnailCoverPath(img);
    
    if (coverPath) {
      img.src = coverPath;
    } else {
      showThumbnailPlaceholder(img);
    }
  });
});
</script>