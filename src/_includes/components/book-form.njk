<!-- Book Form Component -->
<form id="book-form" class="space-y-6" data-book-id="{{ book.id if book else '' }}">
    
    <!-- Form Header -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
            {% if book %}Edit Book: {{ book.title }}{% else %}Add New Book{% endif %}
        </h2>
        
        <!-- Save Actions -->
        <div class="flex justify-end space-x-3 mb-6">
            <button type="button" class="btn-secondary" onclick="cancelEdit()">
                <i class="fas fa-times mr-2"></i>Cancel
            </button>
            <button type="button" class="btn-secondary" onclick="saveDraft()">
                <i class="fas fa-save mr-2"></i>Save Draft
            </button>
            <button type="submit" class="btn-primary">
                <i class="fas fa-check mr-2"></i>
                {% if book %}Update Book{% else %}Add Book{% endif %}
            </button>
        </div>
    </div>

    <!-- Basic Information -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Basic Information</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Title -->
            <div class="md:col-span-2">
                <label for="title" class="block text-sm font-medium text-gray-700 mb-2">
                    Title <span class="text-red-500">*</span>
                </label>
                <input type="text" id="title" name="title" required 
                       class="form-input w-full" 
                       value="{{ book.title if book else '' }}"
                       placeholder="Enter book title">
            </div>

            <!-- Author First Name -->
            <div>
                <label for="author_first" class="block text-sm font-medium text-gray-700 mb-2">
                    Author First Name
                </label>
                <input type="text" id="author_first" name="author_first" 
                       class="form-input w-full" 
                       value="{{ book.author_first if book else '' }}"
                       placeholder="First name">
            </div>

            <!-- Author Last Name -->
            <div>
                <label for="author_last" class="block text-sm font-medium text-gray-700 mb-2">
                    Author Last Name
                </label>
                <input type="text" id="author_last" name="author_last" 
                       class="form-input w-full" 
                       value="{{ book.author_last if book else '' }}"
                       placeholder="Last name">
            </div>

            <!-- Publisher -->
            <div>
                <label for="publisher" class="block text-sm font-medium text-gray-700 mb-2">
                    Publisher
                </label>
                <input type="text" id="publisher" name="publisher" 
                       class="form-input w-full" 
                       value="{{ book.publisher if book else '' }}"
                       placeholder="Publisher name">
            </div>

            <!-- Publication Year -->
            <div>
                <label for="publication_year" class="block text-sm font-medium text-gray-700 mb-2">
                    Publication Year
                </label>
                <input type="number" id="publication_year" name="publication_year" 
                       class="form-input w-full" min="1800" max="2030"
                       value="{{ book.publication_year if book else '' }}"
                       placeholder="YYYY">
            </div>

            <!-- ISBN -->
            <div>
                <label for="isbn" class="block text-sm font-medium text-gray-700 mb-2">
                    ISBN
                </label>
                <input type="text" id="isbn" name="isbn" 
                       class="form-input w-full" 
                       value="{{ book.isbn if book else '' }}"
                       placeholder="ISBN-10 or ISBN-13">
            </div>
        </div>
    </div>

    <!-- Physical Properties -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Physical Properties</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Dimensions -->
            <div>
                <label for="height_cm" class="block text-sm font-medium text-gray-700 mb-2">
                    Height (cm)
                </label>
                <input type="number" id="height_cm" name="height_cm" step="0.1"
                       class="form-input w-full" 
                       value="{{ book.height_cm if book else '' }}"
                       placeholder="0.0">
            </div>
            
            <div>
                <label for="width_cm" class="block text-sm font-medium text-gray-700 mb-2">
                    Width (cm)
                </label>
                <input type="number" id="width_cm" name="width_cm" step="0.1"
                       class="form-input w-full" 
                       value="{{ book.width_cm if book else '' }}"
                       placeholder="0.0">
            </div>
            
            <div>
                <label for="depth_cm" class="block text-sm font-medium text-gray-700 mb-2">
                    Depth (cm)
                </label>
                <input type="number" id="depth_cm" name="depth_cm" step="0.1"
                       class="form-input w-full" 
                       value="{{ book.depth_cm if book else '' }}"
                       placeholder="0.0">
            </div>

            <!-- Page Count -->
            <div>
                <label for="page_count" class="block text-sm font-medium text-gray-700 mb-2">
                    Page Count
                </label>
                <input type="number" id="page_count" name="page_count" 
                       class="form-input w-full" 
                       value="{{ book.page_count if book else '' }}"
                       placeholder="Number of pages">
            </div>

            <!-- Binding -->
            <div>
                <label for="binding_type" class="block text-sm font-medium text-gray-700 mb-2">
                    Binding Type
                </label>
                <select id="binding_type" name="binding_type" class="form-input w-full">
                    <option value="">Select binding type</option>
                    <option value="hardcover" {{ 'selected' if book and book.binding_type == 'hardcover' else '' }}>Hardcover</option>
                    <option value="paperback" {{ 'selected' if book and book.binding_type == 'paperback' else '' }}>Paperback</option>
                    <option value="spiral" {{ 'selected' if book and book.binding_type == 'spiral' else '' }}>Spiral</option>
                    <option value="saddle-stitched" {{ 'selected' if book and book.binding_type == 'saddle-stitched' else '' }}>Saddle-stitched</option>
                    <option value="perfect-bound" {{ 'selected' if book and book.binding_type == 'perfect-bound' else '' }}>Perfect-bound</option>
                    <option value="case-bound" {{ 'selected' if book and book.binding_type == 'case-bound' else '' }}>Case-bound</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Library Management -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Library Management</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Status -->
            <div>
                <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
                    Status <span class="text-red-500">*</span>
                </label>
                <select id="status" name="status" class="form-input w-full" required>
                    <option value="available" {{ 'selected' if book and book.status == 'available' else '' }}>Available</option>
                    <option value="checked_out" {{ 'selected' if book and book.status == 'checked_out' else '' }}>Checked Out</option>
                    <option value="reserved" {{ 'selected' if book and book.status == 'reserved' else '' }}>Reserved</option>
                    <option value="missing" {{ 'selected' if book and book.status == 'missing' else '' }}>Missing</option>
                    <option value="damaged" {{ 'selected' if book and book.status == 'damaged' else '' }}>Damaged</option>
                    <option value="repair" {{ 'selected' if book and book.status == 'repair' else '' }}>In Repair</option>
                </select>
            </div>

            <!-- Location -->
            <div>
                <label for="location_shelf" class="block text-sm font-medium text-gray-700 mb-2">
                    Shelf Location
                </label>
                <input type="text" id="location_shelf" name="location_shelf" 
                       class="form-input w-full" 
                       value="{{ book.location_shelf if book else '' }}"
                       placeholder="e.g., A1, B3, etc.">
            </div>

            <!-- Section -->
            <div>
                <label for="location_section" class="block text-sm font-medium text-gray-700 mb-2">
                    Section
                </label>
                <input type="text" id="location_section" name="location_section" 
                       class="form-input w-full" 
                       value="{{ book.location_section if book else '' }}"
                       placeholder="e.g., Photography, Art, etc.">
            </div>

            <!-- Accession Number -->
            <div>
                <label for="accession_number" class="block text-sm font-medium text-gray-700 mb-2">
                    Accession Number
                </label>
                <input type="text" id="accession_number" name="accession_number" 
                       class="form-input w-full" 
                       value="{{ book.accession_number if book else '' }}"
                       placeholder="Unique library identifier">
            </div>

            <!-- Acquisition Date -->
            <div>
                <label for="acquisition_date" class="block text-sm font-medium text-gray-700 mb-2">
                    Acquisition Date
                </label>
                <input type="date" id="acquisition_date" name="acquisition_date" 
                       class="form-input w-full" 
                       value="{{ book.acquisition_date if book else '' }}">
            </div>

        </div>
    </div>

    <!-- Content & Description -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Content & Description</h3>
        
        <!-- Summary -->
        <div class="mb-6">
            <label for="summary" class="block text-sm font-medium text-gray-700 mb-2">
                Summary
            </label>
            <textarea id="summary" name="summary" rows="4" 
                      class="form-input w-full" 
                      placeholder="Brief summary of the book content">{{ book.summary if book else '' }}</textarea>
        </div>

        <!-- Description -->
        <div class="mb-6">
            <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                Detailed Description
            </label>
            <textarea id="description" name="description" rows="6" 
                      class="form-input w-full" 
                      placeholder="Detailed description for the public catalog">{{ book.description if book else '' }}</textarea>
        </div>

        <!-- Tags -->
        <div class="mb-6">
            <label for="tags" class="block text-sm font-medium text-gray-700 mb-2">
                Tags
            </label>
            <input type="text" id="tags" name="tags" 
                   class="form-input w-full" 
                   value="{{ book.tags | join(', ') if book and book.tags else '' }}"
                   placeholder="Enter tags separated by commas">
            <p class="text-sm text-gray-500 mt-1">Separate multiple tags with commas</p>
        </div>

        <!-- Subjects -->
        <div>
            <label for="subjects" class="block text-sm font-medium text-gray-700 mb-2">
                Subjects
            </label>
            <input type="text" id="subjects" name="subjects" 
                   class="form-input w-full" 
                   value="{{ book.subjects | join(', ') if book and book.subjects else '' }}"
                   placeholder="Photography, Art, Fashion, etc.">
            <p class="text-sm text-gray-500 mt-1">Subject classifications separated by commas</p>
        </div>
    </div>

    <!-- Collections -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Collections</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for collection in collections %}
            <label class="flex items-center p-3 border rounded-lg hover:bg-gray-50 cursor-pointer">
                <input type="checkbox" name="collections" value="{{ collection.id }}" 
                       class="mr-3 h-4 w-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500"
                       {{ 'checked' if book and collection.id in book.collection_ids else '' }}>
                <div>
                    <div class="font-medium text-gray-900">{{ collection.name }}</div>
                    <div class="text-sm text-gray-500">{{ collection.category | title }}</div>
                </div>
            </label>
            {% endfor %}
        </div>
    </div>

    <!-- Cover Image -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Cover Image</h3>
        
        <div class="flex items-start space-x-6">
            <!-- Current Image -->
            {% if book and book.cover_image_url %}
            <div class="flex-shrink-0">
                <img src="{{ book.cover_image_url }}" alt="Current cover" 
                     class="w-32 h-40 object-cover rounded-lg shadow-sm">
            </div>
            {% endif %}
            
            <!-- Upload Area -->
            <div class="flex-1">
                <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-gray-400 transition-colors">
                    <input type="file" id="cover_image" name="cover_image" accept="image/*" class="hidden">
                    <label for="cover_image" class="cursor-pointer">
                        <i class="fas fa-cloud-upload-alt text-4xl text-gray-400 mb-4"></i>
                        <div class="text-sm text-gray-600">
                            <span class="font-medium text-teal-600 hover:text-teal-500">Click to upload</span> 
                            or drag and drop
                        </div>
                        <p class="text-xs text-gray-500 mt-1">PNG, JPG, GIF up to 10MB</p>
                    </label>
                </div>
                
                <!-- Image URL Alternative -->
                <div class="mt-4">
                    <label for="cover_image_url" class="block text-sm font-medium text-gray-700 mb-2">
                        Or enter image URL
                    </label>
                    <input type="url" id="cover_image_url" name="cover_image_url" 
                           class="form-input w-full" 
                           value="{{ book.cover_image_url if book else '' }}"
                           placeholder="https://example.com/image.jpg">
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Flags -->
    <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Display Options</h3>
        
        <div class="space-y-4">
            <label class="flex items-center">
                <input type="checkbox" name="is_featured" value="1" 
                       class="mr-3 h-4 w-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500"
                       {{ 'checked' if book and book.is_featured else '' }}>
                <div>
                    <div class="font-medium text-gray-900">Featured Book</div>
                    <div class="text-sm text-gray-500">Display prominently on homepage</div>
                </div>
            </label>
            
            <label class="flex items-center">
                <input type="checkbox" name="is_staff_pick" value="1" 
                       class="mr-3 h-4 w-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500"
                       {{ 'checked' if book and book.is_staff_pick else '' }}>
                <div>
                    <div class="font-medium text-gray-900">Staff Pick</div>
                    <div class="text-sm text-gray-500">Include in staff recommendations</div>
                </div>
            </label>
            
            <label class="flex items-center">
                <input type="checkbox" name="is_new_acquisition" value="1" 
                       class="mr-3 h-4 w-4 text-teal-600 border-gray-300 rounded focus:ring-teal-500"
                       {{ 'checked' if book and book.is_new_acquisition else '' }}>
                <div>
                    <div class="font-medium text-gray-900">New Acquisition</div>
                    <div class="text-sm text-gray-500">Show in recently added section</div>
                </div>
            </label>
        </div>
    </div>
</form>

<script>
// Book form handling
document.getElementById('book-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const bookId = this.dataset.bookId;
    const url = bookId ? `/admin/api/books/${bookId}` : '/admin/api/books';
    const method = bookId ? 'PUT' : 'POST';
    
    try {
        const response = await fetch(url, {
            method: method,
            body: formData
        });
        
        if (response.ok) {
            const book = await response.json();
            showToast(bookId ? 'Book updated successfully!' : 'Book added successfully!', 'success');
            
            // Redirect to book detail page
            setTimeout(() => {
                window.location.href = `/admin/books/${book.id}`;
            }, 1000);
        } else {
            const error = await response.json();
            showToast(error.message || 'An error occurred', 'error');
        }
    } catch (error) {
        showToast('Network error. Please try again.', 'error');
    }
});

// Save draft functionality
async function saveDraft() {
    const formData = new FormData(document.getElementById('book-form'));
    formData.append('status', 'draft');
    
    try {
        const response = await fetch('/admin/api/books/draft', {
            method: 'POST',
            body: formData
        });
        
        if (response.ok) {
            showToast('Draft saved!', 'success');
        } else {
            showToast('Failed to save draft', 'error');
        }
    } catch (error) {
        showToast('Network error', 'error');
    }
}

// Cancel edit
function cancelEdit() {
    if (confirm('Are you sure? Any unsaved changes will be lost.')) {
        window.history.back();
    }
}

// File upload preview
document.getElementById('cover_image').addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            // Create preview if doesn't exist
            let preview = document.getElementById('image-preview');
            if (!preview) {
                preview = document.createElement('img');
                preview.id = 'image-preview';
                preview.className = 'w-32 h-40 object-cover rounded-lg shadow-sm mt-4';
                e.target.parentElement.appendChild(preview);
            }
            preview.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }
});

// Auto-generate slug from title
document.getElementById('title').addEventListener('input', function(e) {
    // This would generate a URL-friendly slug for the book
    const slug = e.target.value.toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .trim('-');
    // Could update a hidden slug field here
});
</script>