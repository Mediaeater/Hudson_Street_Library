<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "{{ title | escape }}",
  "url": "https://hudsonstreetlibrary.com{{ permalink }}"
  {%- if description %},
  "description": "{{ description | escape | replace('\n', ' ') | replace('\r', '') }}"
  {%- endif %},
  "isPartOf": {
    "@type": "WebSite",
    "name": "Hudson Street Library",
    "url": "https://hudsonstreetlibrary.com"
  }
}
</script>
