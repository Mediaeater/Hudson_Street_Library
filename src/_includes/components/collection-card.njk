{# Expects: book. Styles live in src/collections.njk. #}
<a href="/books/{{ book.author_last | slugify }}_{{ book.title | slugify }}_{{ book.id }}/" class="collection-book">
    <div class="collection-book-cover">
        {% if book | hasCover %}
            <img src="{{ book | generateCoverPath }}" alt="{{ book.title }}" loading="lazy">
        {% else %}
            <span class="no-cover">No cover</span>
        {% endif %}
    </div>
    {% if book.author_full_name %}
        <div class="collection-book-author">{{ book.author_full_name }}</div>
    {% endif %}
    <div class="collection-book-title">{{ book.title }}</div>
    {% if book.publisher or book.publication_year %}
        <div class="collection-book-meta">{% if book.publisher %}{{ book.publisher }}{% if book.publication_year %} &middot; {% endif %}{% endif %}{{ book.publication_year }}</div>
    {% endif %}
</a>
