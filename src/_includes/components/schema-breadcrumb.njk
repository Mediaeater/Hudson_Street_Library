<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hudsonstreetlibrary.com/"
    }
    {%- if book %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Books",
      "item": "https://hudsonstreetlibrary.com/static-demo/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ book.title | escape }}",
      "item": "https://hudsonstreetlibrary.com{{ page.url }}"
    }
    {#- A wing landing page sits directly under the homepage: it is the front
        door for its wing, not an entry in the art wing's collections index. -#}
    {%- elif wingPage %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ wingPage.name | escape }}",
      "item": "https://hudsonstreetlibrary.com{{ page.url }}"
    }
    {#- `page.url` is the resolved URL. `permalink` is the raw front-matter
        string, which on any paginated page is itself a template expression and
        would ship unrendered — the same bug fixed in schema-collection.njk. -#}
    {%- elif title and permalink %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Collections",
      "item": "https://hudsonstreetlibrary.com/collection-explore.html"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title | escape }}",
      "item": "https://hudsonstreetlibrary.com{{ page.url }}"
    }
    {%- endif %}
  ]
}
</script>
