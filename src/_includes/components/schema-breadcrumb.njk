<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hudsonstreetlibrary.com/"
    }
    {%- if book %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Books",
      "item": "https://hudsonstreetlibrary.com/static-demo/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ book.title | jsonString | safe }},
      "item": {{ ("https://hudsonstreetlibrary.com" + page.url) | jsonString | safe }}
    }
    {#- A wing landing page sits directly under the homepage: it is the front
        door for its wing, not an entry in the art wing's collections index. -#}
    {%- elif wingPage %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ wingPage.name | jsonString | safe }},
      "item": {{ ("https://hudsonstreetlibrary.com" + page.url) | jsonString | safe }}
    }
    {#- `page.url` is the resolved URL. `permalink` is the raw front-matter
        string, which on any paginated page is itself a template expression and
        would ship unrendered — the same bug fixed in schema-collection.njk. -#}
    {#- A collection outside the default wing sits under its wing's landing
        page; /collection-explore.html lists the art wing only. -#}
    {%- elif title and permalink %},
    {%- set crumbWing = collectionConfig.wing | nonDefaultWing if collectionConfig else null %}
    {
      "@type": "ListItem",
      "position": 2,
      {%- if crumbWing %}
      "name": {{ crumbWing.name | jsonString | safe }},
      "item": {{ ("https://hudsonstreetlibrary.com/" + crumbWing.slug + "/") | jsonString | safe }}
      {%- else %}
      "name": "Collections",
      "item": "https://hudsonstreetlibrary.com/collection-explore.html"
      {%- endif %}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ title | jsonString | safe }},
      "item": {{ ("https://hudsonstreetlibrary.com" + page.url) | jsonString | safe }}
    }
    {%- endif %}
  ]
}
</script>
