<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hudsonstreetlibrary.com/"
    }
    {%- if book %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Books",
      "item": "https://hudsonstreetlibrary.com/static-demo/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ book.title | escape }}",
      "item": "https://hudsonstreetlibrary.com{{ page.url }}"
    }
    {%- elif title and permalink %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Collections",
      "item": "https://hudsonstreetlibrary.com/collection-explore.html"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title | escape }}",
      "item": "https://hudsonstreetlibrary.com{{ permalink }}"
    }
    {%- endif %}
  ]
}
</script>
