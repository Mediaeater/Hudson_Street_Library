{# Expects: section (label, subtitle, books). A null label prints no heading.
   Styles live in src/collections.njk. #}
<section class="collection-section">
    {% if section.label %}
    <div class="collection-section-head">
        <h2>{{ section.label }}</h2>
        {% if section.subtitle %}<span>{{ section.subtitle }}</span>{% endif %}
    </div>
    {% endif %}
    <div class="collection-books">
        {% for book in section.books %}
            {% include "components/collection-card.njk" %}
        {% endfor %}
    </div>
</section>
