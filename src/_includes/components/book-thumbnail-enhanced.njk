{#
  Enhanced Book Thumbnail Component with clickable metadata and tags
  Usage: {% include "components/book-thumbnail-enhanced.njk", book: bookData, size: "medium" %}
  Parameters:
  - book: Book object from CSV
  - size: "small", "medium", "large" (optional, defaults to medium)
  - className: Additional CSS classes (optional)
  - showTags: Whether to show tags (optional, defaults to true)
  - showMeta: Whether to show metadata (optional, defaults to true)
#}

{% set thumbnailSize = size or 'medium' %}
{% set bookTitle = book.title or book.Title or 'Untitled' %}
{% set bookAuthor = book.author_full_name or ((book.author_first or '') + ' ' + (book.author_last or '')).trim() or '' %}
{% set imageField = book.image_url or book.Image or book.cover_image %}
{% set bookISBN = book.isbn_asin or book.ISBN or '' %}
{% set bookPublisher = book.publisher or book.Publisher or '' %}
{% set bookYear = book.publication_year or book.Year or '' %}
{% set bookCollection = book.collection_grouping or '' %}

{# Parse tags #}
{% set bookTags = [] %}
{% if book.tags and book.tags != 'NULL' %}
  {% set bookTags = book.tags.split(',') | map('trim') | select('truthy') | list %}
{% endif %}

{% if thumbnailSize == 'small' %}
  {% set containerClass = 'w-20 h-24' %}
  {% set iconSize = 'text-lg' %}
  {% set titleSize = 'text-xs' %}
{% elif thumbnailSize == 'large' %}
  {% set containerClass = 'w-48 h-64' %}
  {% set iconSize = 'text-4xl' %}
  {% set titleSize = 'text-sm' %}
{% else %}
  {% set containerClass = 'w-32 h-40' %}
  {% set iconSize = 'text-2xl' %}
  {% set titleSize = 'text-xs' %}
{% endif %}

<div class="book-thumbnail-enhanced group {{ className or '' }}">
  <div class="relative {{ containerClass }} bg-gray-200 rounded-lg overflow-hidden shadow-md group-hover:shadow-lg transition-shadow">
    <img class="thumbnail-image w-full h-full object-cover" 
         alt="Cover of {{ bookTitle | escape }}"
         data-title="{{ bookTitle | escape }}"
         data-author="{{ bookAuthor | escape }}"
         data-isbn="{{ bookISBN | escape }}"
         data-image-field="{{ imageField | escape }}"
         style="display:none;"
         onload="this.style.display='block'; this.nextElementSibling.style.display='none';"
         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
    <!-- Placeholder shown initially and on error -->
    <div class="thumbnail-placeholder w-full h-full flex flex-col items-center justify-center text-gray-500 bg-gray-100 p-2">
      <i class="fas fa-book {{ iconSize }} mb-1"></i>
      <p class="{{ titleSize }} text-center leading-tight px-1">{{ bookTitle | escape | truncate(25) }}</p>
      {% if bookAuthor %}
        <p class="text-xs text-gray-400 mt-1 text-center">{{ bookAuthor | escape | truncate(20) }}</p>
      {% endif %}
    </div>
  </div>
  
  {% if showMeta != false %}
    <div class="mt-2 px-1">
      <h3 class="{{ titleSize }} font-medium text-gray-900 leading-tight line-clamp-2">{{ bookTitle | escape }}</h3>
      
      {% if bookAuthor %}
        <p class="text-xs text-gray-600 mt-1">
          <a href="/aggregate-view.html?filter=author&value={{ bookAuthor | urlencode }}" 
             class="hover:text-teal-700 hover:underline">
            {{ bookAuthor | escape }}
          </a>
        </p>
      {% endif %}
      
      {% if bookPublisher and bookPublisher != 'NULL' %}
        <p class="text-xs text-gray-500 mt-0.5">
          <a href="/aggregate-view.html?filter=publisher&value={{ bookPublisher | urlencode }}" 
             class="hover:text-teal-700 hover:underline">
            {{ bookPublisher | escape }}
          </a>
        </p>
      {% endif %}
      
      {% if bookYear and bookYear != 'NULL' %}
        <p class="text-xs text-gray-500">
          <a href="/aggregate-view.html?filter=year&value={{ bookYear | urlencode }}" 
             class="hover:text-teal-700 hover:underline">
            {{ bookYear }}
          </a>
        </p>
      {% endif %}
      
      {% if showTags != false and bookTags.length > 0 %}
        <div class="mt-1 text-xs text-neutral-600">
          {{ bookTags | join(', ') }}
        </div>
      {% endif %}

      {% if bookCollection and bookCollection != 'NULL' %}
        <div class="mt-1 text-xs text-neutral-600">
          {{ bookCollection | escape }}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

<style>
.line-clamp-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
</style>