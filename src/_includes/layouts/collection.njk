{#
  Collection Page Layout
  Parameters:
  - title: Page title
  - description: Meta description
  - currentPage: For nav highlighting (defaults to 'collections')
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | Hudson Street Library</title>
    {% if description %}
    <meta name="description" content="{{ description | truncate(155) | escape }}">
    {% endif %}
    <link rel="stylesheet" href="/assets/css/design-system.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    {% include "components/schema-organization.njk" %}
    {% include "components/schema-collection.njk" %}
    {% include "components/schema-breadcrumb.njk" %}
</head>
<body class="min-h-screen bg-neutral-50 text-neutral-900">

{% include "components/site-header.njk" %}

{{ content | safe }}

{% include "components/site-footer.njk" %}

<script>
    // Mobile Menu Toggle Logic
    const mobileMenuButton = document.querySelector('button.md\\:hidden');
    const mobileNavMenu = document.getElementById('mobile-nav-menu');

    if (mobileMenuButton && mobileNavMenu) {
        mobileMenuButton.addEventListener('click', function() {
            const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
            mobileMenuButton.setAttribute('aria-expanded', !isExpanded);
            mobileNavMenu.classList.toggle('hidden');
            mobileNavMenu.classList.toggle('flex');
            const icon = mobileMenuButton.querySelector('i');
            if (icon) {
                icon.classList.toggle('fa-bars');
                icon.classList.toggle('fa-times');
            }
        });
    }

    // Smooth Scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            if (this.hash) {
               const targetElement = document.querySelector(this.hash);
               if (targetElement) {
                    e.preventDefault();
                    const headerOffset = document.querySelector('header')?.offsetHeight || 70;
                    const elementPosition = targetElement.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
                    window.scrollTo({ top: offsetPosition, behavior: "smooth" });
                    if (mobileMenuButton && mobileMenuButton.getAttribute('aria-expanded') === 'true') {
                         mobileMenuButton.click();
                    }
               }
            }
        });
    });
</script>

</body>
</html>
