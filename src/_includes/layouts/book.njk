<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ book.title }} by {{ book.author_full }} | Hudson Street Library</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <style>
        .details-label {
            font-weight: 600;
            color: #374151;
            margin-right: 0.5rem;
        }
        .section-heading {
            font-size: 1.5rem;
            font-weight: 700;
            color: #111827;
            margin-bottom: 1rem;
        }
        .availability-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .availability-badge.available {
            background-color: #D1FAE5;
            color: #065F46;
        }
        .prose {
            line-height: 1.75;
            color: #374151;
        }
        .prose p {
            margin-bottom: 1rem;
        }
    </style>
</head>
<body class="min-h-screen bg-neutral-50">

<div class="book-page-container px-4 md:px-8 lg:px-16 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    <!-- Left Column: Image Only -->
    <div class="lg:col-span-1">
      <!-- Book Cover Image -->
      <div class="book-cover-container mb-8">
        <img
          src="{{ book.image_url or '../../assets/images/placeholder-book.svg' }}"
          alt="Cover of {{ book.title }}"
          class="w-full h-auto object-contain bg-gray-50 rounded-md shadow-lg border {{ 'border-neutral-200' if book.image_url else 'border-neutral-100' }}"
        />
      </div>

      {% if book.publisher_url %}
        <a href="{{ book.publisher_url }}" target="_blank"
           class="inline-block w-full px-4 py-2 bg-teal-600 text-white text-center rounded-md hover:bg-teal-700 transition-colors">
          View at Publisher →
        </a>
      {% endif %}
    </div>

    <!-- Right Column: Title, Author, Description, Details, etc. -->
    <div class="lg:col-span-2">
      <!-- Title and Author -->
      <header class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ book.title or 'Untitled' }}</h1>
        <p class="text-2xl text-gray-700">
          by
          {% if book.artist_url %}
            <a href="{{ book.artist_url }}" target="_blank" class="text-teal-700 hover:text-teal-900 underline">{{ book.author_full_name or 'Unknown Author' }}</a>
          {% else %}
            {{ book.author_full_name or 'Unknown Author' }}
          {% endif %}
        </p>
      </header>

      <!-- Description -->
      <section class="mb-12">
        <h2 class="section-heading">Description</h2>
        <div class="prose max-w-none mb-8">
          {{ book.description | safe or '<p>No description available.</p>' }}
        </div>

        <!-- Details (moved under description) -->
        <div class="mt-8 pt-8 border-t border-gray-200">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Details</h3>
          <div class="grid grid-cols-2 gap-x-8 gap-y-2 text-sm">
            {% if book.is_signed_inscribed == 'true' or book.is_signed_inscribed == '1' %}
              <p><span class="details-label">Signed:</span> Yes</p>
            {% endif %}
            <p><span class="details-label">Publisher:</span>
              {% if book.publisher_url %}
                <a href="{{ book.publisher_url }}" target="_blank" class="text-teal-700 hover:text-teal-900 underline">{{ book.publisher or 'Not specified' }}</a>
              {% else %}
                {{ book.publisher or 'Not specified' }}
              {% endif %}
            </p>
            <p><span class="details-label">Published:</span> {{ book.publication_year or 'Not specified' }}</p>
            <p><span class="details-label">ISBN:</span> {{ book.isbn_asin or 'Not specified' }}</p>
            <p><span class="details-label">Format:</span> {{ book.binding or 'Not specified' }}</p>
            <p><span class="details-label">Pages:</span> {{ book.page_count or 'Not specified' }}</p>
            {% if book.num_images %}<p><span class="details-label">Images:</span> {{ book.num_images }}</p>{% endif %}
            <p><span class="details-label">Dimensions:</span>
              {% if book.height_cm and book.width_cm %}
                {{ book.height_cm }}cm × {{ book.width_cm }}cm
                {% if book.depth_cm %} × {{ book.depth_cm }}cm{% endif %}
              {% else %}
                Not specified
              {% endif %}
            </p>
            {% if book.weight_g %}<p><span class="details-label">Weight:</span> {{ book.weight_g }}g</p>{% endif %}
            {% if book.language %}<p><span class="details-label">Language:</span> {{ book.language }}</p>{% endif %}
            {% if book.edition_printrun %}<p><span class="details-label">Edition:</span> {{ book.edition_printrun }}</p>{% endif %}
            {% if book.price %}<p><span class="details-label">Price:</span> {{ book.price }}</p>{% endif %}
          </div>
        </div>
      </section>

      <!-- Notes (for non-uniform information) -->
      {% if book.notes %}
        <section class="mb-12">
          <h2 class="section-heading">Notes</h2>
          <div class="prose max-w-none text-sm text-gray-700" style="white-space: pre-line;">{{ book.notes }}</div>
        </section>
      {% endif %}

      <!-- Contributors -->
      {% if book.editor or book.contributors or book.designer %}
        <section class="mb-12">
          <h2 class="section-heading">Contributors</h2>
          <div class="space-y-2 text-sm md:text-base">
            {% if book.editor %}<p><span class="details-label">Editor:</span> {{ book.editor }}</p>{% endif %}
            {% if book.contributors %}<p><span class="details-label">Contributors:</span> {{ book.contributors }}</p>{% endif %}
            {% if book.designer %}<p><span class="details-label">Designer:</span> {{ book.designer }}</p>{% endif %}
          </div>
        </section>
      {% endif %}

      <!-- Tags & Classification -->
      {% if book.tags or book.classification %}
        <section class="mb-12">
          <h2 class="section-heading">Tags & Classification</h2>

          {% if book.tags %}
            <div class="mb-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Tags:</h3>
              <p class="text-sm text-gray-600">
                {% set tag_list = book.tags.split(',') %}
                {% for tag in tag_list %}<a href="/static-demo/?tag={{ tag.trim() | urlencode }}" class="text-teal-700 hover:text-teal-900 underline">{{ tag.trim() }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
            </div>
          {% endif %}

          {% if book.classification %}
            <div class="mb-4">
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Classification:</h3>
              <p class="text-sm text-gray-600">{{ book.classification }}</p>
            </div>
          {% endif %}

          {% if book.collection_grouping %}
            <div>
              <h3 class="text-sm font-semibold text-gray-700 mb-2">Collections:</h3>
              <p class="text-sm text-gray-600">{{ book.collection_grouping }}</p>
            </div>
          {% endif %}
        </section>
      {% endif %}

      <!-- Library Information -->
      <section class="mb-12">
        <h2 class="section-heading">Library Information</h2>
        <div class="space-y-2 text-sm md:text-base">
          <p><span class="details-label">Location:</span> {{ book.location or 'Hudson Street Library, NYC' }}</p>
          <p><span class="details-label">Acquired:</span> {{ book.accession_no or 'Original Collection' }}</p>
        </div>
      </section>
    </div>
  </div>
</div>

</body>
</html>
