<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Book Title from CSV 'Title' column -->
    <title>{{ book.Title }} | Hudson Street Library Collection</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap');

        html { scroll-behavior: smooth; }
        body { font-family: 'Montserrat', sans-serif; background-color: #fdfdfb; color: #374151; /* gray-700 */ }
        h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', serif; color: #111827; /* gray-900 */ }

        .nav-item::after { content: ''; display: block; width: 0; height: 1px; background: #0f766e; transition: width .3s; }
        .nav-item:hover::after { width: 100%; }

        .details-label {
            font-weight: 500; /* medium */
            color: #4b5563; /* gray-600 */
            min-width: 130px; /* Increased for more visual space */
            display: inline-block;
            margin-bottom: 4px; /* Add small spacing between labels */
        }

        .detail-section-title {
            margin-bottom: 0.75rem; /* Equivalent to mb-3 */
            margin-top: 1.5rem; /* Add space above section title */
        }

        .prose p {
            margin-bottom: 0.75rem; /* Spacing between paragraphs */
        }

        .subject-tag {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: #e6fffa;
            color: #0f766e;
            border-radius: 9999px;
            font-size: 0.875rem;
            margin: 0.25rem;
            transition: all 0.2s;
        }

        .subject-tag:hover {
            background-color: #99f6e4;
            color: #115e59;
        }

        .collection-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: #0f766e;
            color: white;
            border-radius: 9999px;
            font-size: 0.875rem;
            margin-bottom: 1rem;
        }
    </style>
    <script>
      tailwind.config = { theme: { extend: { colors: {} } } }
    </script>
</head>
<body class="bg-gray-50 text-gray-800">

    <!-- Standard Site Header -->
    <header class="sticky top-0 w-full bg-white z-50 py-4 shadow-md">
        <div class="container mx-auto px-6">
            <div class="flex justify-between items-center">
                <!-- Fixed path -->
                <a href="/index.html" class="text-xl sm:text-2xl font-bold tracking-tight text-teal-900">HUDSON STREET LIBRARY</a>
                <nav id="main-nav" class="hidden md:flex space-x-6 lg:space-x-8 items-center text-neutral-700 text-sm lg:text-base">
                    <!-- Fixed paths -->
                    <a href="/index.html#about" class="nav-item hover:text-teal-700">About</a>
                    <a href="/collection-explore.html" class="nav-item hover:text-teal-700">Collections</a>
                    <a href="/static-demo.html" class="nav-item hover:text-teal-700">Search</a>
                    <a href="/index.html#publications" class="nav-item hover:text-teal-700">Publications</a>
                    <a href="/news.html" class="nav-item hover:text-teal-700">News</a>
                    <a href="/index.html#contact" class="nav-item hover:text-teal-700">Contact</a>
                </nav>
                <button class="md:hidden focus:outline-none text-teal-800" aria-label="Toggle menu" aria-controls="mobile-nav-menu-book" aria-expanded="false">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
        <!-- Mobile Nav with fixed paths -->
        <nav id="mobile-nav-menu-book" class="hidden md:hidden absolute top-full left-0 right-0 bg-white shadow-lg px-6 py-4 space-y-3 flex-col z-40">
             <a href="/index.html#about" class="block py-2 text-neutral-700 hover:text-teal-700">About</a>
             <a href="/collection-explore.html" class="block py-2 text-neutral-700 hover:text-teal-700">Collections</a>
             <a href="/static-demo.html" class="block py-2 text-neutral-700 hover:text-teal-700">Search</a>
             <a href="/index.html#publications" class="block py-2 text-neutral-700 hover:text-teal-700">Publications</a>
             <a href="/news.html" class="block py-2 text-neutral-700 hover:text-teal-700">News</a>
             <a href="/index.html#contact" class="block py-2 text-neutral-700 hover:text-teal-700">Contact</a>
        </nav>
    </header>

    <main>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">

            <!-- Back Link - Fixed path -->
            <div class="mb-8">
                <a href="/collection-explore.html" class="text-sm text-teal-700 hover:text-teal-900 transition-colors">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Collections
                </a>
            </div>

            <!-- Main Book Info Grid -->
            <article class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">

                <!-- Left Column: Cover Image -->
                <div class="md:col-span-1">
                    <div class="sticky top-28"> <!-- Sticky positioning for cover -->
                        <div class="aspect-[3/4] bg-gray-200 rounded-md shadow-lg overflow-hidden relative">
                            <img id="book-cover-img"
                                 alt="Cover of {{ book.Title | escape }}"
                                 class="w-full h-full object-cover"
                                 onerror="showPlaceholder()">
                            <!-- Fallback content for missing images -->
                            <div id="book-placeholder" class="w-full h-full flex flex-col items-center justify-center text-gray-500 bg-gray-100" style="display:none;">
                                <i class="fas fa-book text-4xl mb-2"></i>
                                <p class="text-sm text-center px-4">{{ book.Title | escape }}</p>
                                <p class="text-xs text-gray-400 mt-1">{{ book['Author, First'] }} {{ book['Author, Last'] }}</p>
                            </div>
                        </div>
                        
                        <script>
                        function generateCoverImagePath() {
                            // Extract book data from Nunjucks template
                            const author = '{{ book["Author, First"] }} {{ book["Author, Last"] }}'.replace(/[^a-zA-Z0-9.-]/g, '_');
                            const title = '{{ book.Title }}'.replace(/[^a-zA-Z0-9.-]/g, '_');
                            const isbn = '{{ book.ISBN }}'.replace(/[^a-zA-Z0-9.-]/g, '_');
                            
                            // Check if we have existing image
                            {% if book.Image and book.Image.trim() %}
                                return '/assets/images/books/{{ book.Image }}';
                            {% endif %}
                            
                            // Generate path from our acquired covers
                            if (isbn && isbn !== 'NULL' && isbn !== '') {
                                const coverFileName = `${author}_${title}_${isbn}`.replace(/_+/g, '_').replace(/^_|_$/g, '').substring(0, 100) + '.jpg';
                                return `/assets/images/books/${coverFileName}`;
                            } else {
                                // Try with noISBN suffix for books without ISBN
                                const coverFileName = `${author}_${title}_noISBN`.replace(/_+/g, '_').replace(/^_|_$/g, '').substring(0, 100) + '.jpg';
                                return `/assets/images/books/${coverFileName}`;
                            }
                            
                            return null;
                        }
                        
                        function showPlaceholder() {
                            document.getElementById('book-cover-img').style.display = 'none';
                            document.getElementById('book-placeholder').style.display = 'flex';
                        }
                        
                        function loadBookCover() {
                            const imgElement = document.getElementById('book-cover-img');
                            const coverPath = generateCoverImagePath();
                            
                            if (coverPath) {
                                imgElement.src = coverPath;
                            } else {
                                showPlaceholder();
                            }
                        }
                        
                        // Load cover when page loads
                        document.addEventListener('DOMContentLoaded', loadBookCover);
                        </script>
                    </div>
                </div>

                <!-- Right Column: Details -->
                <div class="md:col-span-2">
                    <!-- Collection Badge using 'Collection Grouping' column -->
                    {% if book['Collection Grouping'] %}
                    <div class="mb-2">
                        <p class="text-base font-medium">Collection: {{ book['Collection Grouping'] }}</p>
                    </div>
                    {% endif %}

                    <!-- Title using 'Title' column -->
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold title-font mb-2 text-gray-900">
                        {{ book.Title }}
                    </h1>

                    <!-- Author using 'Author, First' and 'Author, Last' columns -->
                    <p class="text-lg text-gray-800 mb-6">
                        {# Combine First and Last name for author display #}
                        By <span class="font-medium">{{ book['Author, First'] }} {{ book['Author, Last'] }}</span>
                    </p>

                    <!-- Core Details Section -->
                    <div class="border-t border-gray-200 pt-6 space-y-3 text-base">
                        {% if book.Publisher %}<p><span class="details-label">Published by:</span> {{ book.Publisher }}</p>{% endif %}
                        {% if book.Location %}<p><span class="details-label">Location:</span> {{ book.Location }}</p>{% endif %}
                        {% if book.Date %}<p><span class="details-label">Date:</span> {{ book.Date }}</p>{% endif %}
                        {# Language not in schema #}
                        {% if book['Edition/Printrun'] %}
                        <p><span class="details-label">Edition/Format:</span> {{ book['Edition/Printrun'] }}</p> {# Mapping Edition as Format #}
                        {% endif %}
                        {% if book.Size %}<p><span class="details-label">Dimensions:</span> {{ book.Size }}</p>{% endif %}
                        {% if book.ISBN %}<p><span class="details-label">ISBN:</span> {{ book.ISBN }}</p>{% endif %} {# Displaying combined ISBN #}
                        {% if book.Contributors %}<p><span class="details-label">Contributors:</span> {{ book.Contributors }}</p>{% endif %}
                        {% if book.Classification %}<p><span class="details-label">LC Call No.:</span> {{ book.Classification }}</p>{% endif %} {# Mapping Classification as LC Call No. #}
                        {# Addition Date not in schema #}
                        {% if book['Accession No'] %}<p><span class="details-label">Accession No:</span> {{ book['Accession No'] }}</p>{% endif %} {# Added Accession No #}
                        {% if book.Designer %}<p><span class="details-label">Designer:</span> {{ book.Designer }}</p>{% endif %} {# Added Designer #}
                         {% if book['Author, Editor'] %}<p><span class="details-label">Editor:</span> {{ book['Author, Editor'] }}</p>{% endif %} {# Added Editor #}
                    </div>

                     <!-- Summary Section using 'Summary' column -->
                     {% if book.Summary %}
                     <div class="mt-8 pt-6 border-t border-gray-200">
                         <h3 class="text-2xl font-semibold title-font mb-3">Summary</h3>
                         <div class="prose max-w-none text-gray-700 leading-relaxed">
                            {{ book.Summary | escape }} {# Remove | safe to prevent XSS attacks #}
                         </div>
                     </div>
                     {% endif %}

                    <!-- Subjects using 'Subject classification, tags' column -->
                    {% if book['Subject classification, tags'] %}
                    <section>
                        <h2 class="detail-section-title text-xl">Subjects</h2>
                        <div class="flex flex-wrap gap-2 mt-2">
                            {% for subject in book['Subject classification, tags'].split(',') %} {# Split comma-separated string #}
                                {% set trimmed_subject = subject | trim %} {# Trim whitespace #}
                                {% if trimmed_subject %} {# Ensure not empty after trimming #}
                                    <span class="subject-tag">{{ trimmed_subject }}</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </section>
                    {% endif %}

                    <!-- Related Names using 'Contributors' column -->
                    {% if book.Contributors %}
                    <section>
                        <h2 class="detail-section-title text-xl">Related Names</h2>
                        <ul class="list-disc list-inside space-y-1">
                           {% for name in book.Contributors.split(',') %} {# Split comma-separated string #}
                                {% set trimmed_name = name | trim %}
                                {% if trimmed_name %}
                                    <li>{{ trimmed_name }}</li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </section>
                    {% endif %}

                    <!-- Notes using 'Information; Notes ; Condition' and 'Signed/Inscribed' columns -->
                    {% if book['Information; Notes ; Condition'] or book['Signed/Inscribed'] %}
                    <section>
                        <h2 class="detail-section-title text-xl">Notes</h2>
                        {% if book['Information; Notes ; Condition'] %}<p>{{ book['Information; Notes ; Condition'] }}</p>{% endif %}
                        {% if book['Signed/Inscribed'] %}<p><strong>Signed/Inscribed:</strong> {{ book['Signed/Inscribed'] }}</p>{% endif %}
                    </section>
                    {% endif %}

                </div>
            </article>

        </div><!-- /.container -->
    </main>

    <!-- Standard Footer -->
    <footer class="bg-neutral-900 text-neutral-300 py-16">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between pb-12 border-b border-neutral-700">
                <div class="mb-8 md:mb-0">
                    <h3 class="text-2xl font-bold mb-4 text-white">HUDSON STREET LIBRARY</h3>
                    <p class="text-neutral-400 max-w-xs">A specialized photography book collection in Manhattan's West Village.</p>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
                    <div>
                        <h4 class="font-semibold text-lg mb-4 text-neutral-100">Explore</h4>
                        <ul class="space-y-2 text-neutral-400">
                            <li><a href="/index.html" class="hover:text-white">Home</a></li>
                            <li><a href="/index.html#about" class="hover:text-white">About</a></li>
                            <li><a href="/collection-explore.html" class="hover:text-white">Collections</a></li>
                            <li><a href="/index.html#publications" class="hover:text-white">Publications</a></li>
                            <li><a href="/news.html" class="hover:text-white">News</a></li>
                            <li><a href="/index.html#contact" class="hover:text-white">Contact</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-semibold text-lg mb-4 text-neutral-100">Visit</h4>
                        <ul class="space-y-2 text-neutral-400">
                            <li><a href="/index.html#contact" class="hover:text-white">Visit Policy</a></li>
                            <li><a href="/index.html#contact" class="hover:text-white">Location</a></li>
                            <li><a href="/index.html#contact" class="hover:text-white">Appointments</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-semibold text-lg mb-4 text-neutral-100">Connect</h4>
                        <ul class="space-y-2 text-neutral-400">
                            <li><a href="#" class="hover:text-white">Instagram</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="pt-12 text-center text-neutral-500 text-sm">
                <p>© 2024 Hudson Street Library. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuButton = document.querySelector('button[aria-controls="mobile-nav-menu-book"]');
            const mobileNavMenu = document.getElementById('mobile-nav-menu-book');

            if (mobileMenuButton && mobileNavMenu) {
                mobileMenuButton.addEventListener('click', function() {
                    const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
                    mobileMenuButton.setAttribute('aria-expanded', !isExpanded);
                    mobileNavMenu.classList.toggle('hidden');
                    mobileNavMenu.classList.toggle('flex');
                    const icon = mobileMenuButton.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('fa-bars');
                        icon.classList.toggle('fa-times');
                    }
                });
            }
        });
    </script>

</body>
</html>