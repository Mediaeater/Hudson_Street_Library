<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ book.title }} by {{ book.author_full }} | Hudson Street Library</title>
    <link rel="stylesheet" href="/assets/css/design-system.css">
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
</head>
<body class="min-h-screen bg-neutral-50">

<div class="book-page-container px-4 md:px-8 lg:px-16 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
    <!-- Left Column: Image and Details -->
    <div class="lg:col-span-1">
      <!-- Book Cover Image -->
      <div class="book-cover-container mb-8">
        <img
          src="{{ book.image_url or '../../assets/images/placeholder-book.svg' }}"
          alt="Cover of {{ book.title }}"
          class="w-full h-auto object-contain bg-gray-50 rounded-md shadow-lg border {{ 'border-neutral-200' if book.image_url else 'border-neutral-100' }}"
        />
      </div>

      <!-- Book Details -->
      <div class="book-details space-y-4">
        <h2 class="text-xl font-bold text-gray-800">Details</h2>
        <div class="space-y-2 text-sm md:text-base">
          <p><span class="details-label">Publisher:</span>
            {% if book.publisher_url %}
              <a href="{{ book.publisher_url }}" target="_blank" class="text-teal-700 hover:text-teal-900 underline">{{ book.publisher or 'Not specified' }}</a>
            {% else %}
              {{ book.publisher or 'Not specified' }}
            {% endif %}
          </p>
          <p><span class="details-label">Published:</span> {{ book.publication_year or 'Not specified' }}</p>
          <p><span class="details-label">ISBN:</span> {{ book.isbn_asin or 'Not specified' }}</p>
          <p><span class="details-label">Format:</span> {{ book.binding or 'Not specified' }}</p>
          <p><span class="details-label">Pages:</span> {{ book.page_count or 'Not specified' }}</p>
          <p><span class="details-label">Dimensions:</span>
            {% if book.height_cm and book.width_cm %}
              {{ book.height_cm }}cm (H) × {{ book.width_cm }}cm (W)
              {% if book.depth_cm %}× {{ book.depth_cm }}cm (D){% endif %}
            {% else %}
              Not specified
            {% endif %}
          </p>
          <p><span class="details-label">Language:</span> English</p>
          <p><span class="details-label">Edition:</span> {{ book.edition_printrun or 'Not specified' }}</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Title, Author, Description, etc. -->
    <div class="lg:col-span-2">
      <!-- Title and Author -->
      <header class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">{{ book.title or 'Untitled' }}</h1>
        <p class="text-2xl text-gray-700">
          by
          {% if book.artist_url %}
            <a href="{{ book.artist_url }}" target="_blank" class="text-teal-700 hover:text-teal-900 underline">{{ book.author_full_name or 'Unknown Author' }}</a>
          {% else %}
            {{ book.author_full_name or 'Unknown Author' }}
          {% endif %}
        </p>
      </header>

      <!-- Description -->
      <section class="mb-12">
        <h2 class="section-heading">Description</h2>
        <div class="prose max-w-none">
          {{ book.description | safe or '<p>No description available.</p>' }}
        </div>
      </section>

      <!-- Contributors -->
      {% if book.editor or book.contributors or book.designer %}
        <section class="mb-12">
          <h2 class="section-heading">Contributors</h2>
          <div class="space-y-2 text-sm md:text-base">
            {% if book.editor %}<p><span class="details-label">Editor:</span> {{ book.editor }}</p>{% endif %}
            {% if book.contributors %}<p><span class="details-label">Contributors:</span> {{ book.contributors }}</p>{% endif %}
            {% if book.designer %}<p><span class="details-label">Designer:</span> {{ book.designer }}</p>{% endif %}
          </div>
        </section>
      {% endif %}

      <!-- Library Information -->
      <section class="mb-12">
        <h2 class="section-heading">Library Information</h2>
        <div class="space-y-2 text-sm md:text-base">
          <p><span class="details-label">Accession:</span> {{ book.accession_no or 'Original Collection' }}</p>
          <p><span class="details-label">Condition:</span> New</p>
          <p><span class="details-label">Notes:</span>
            {% set special_notes = [] %}
            {% if book.is_signed_inscribed == 'true' or book.is_signed_inscribed == '1' %}{% set special_notes = (special_notes.push('Signed by author'), special_notes) %}{% endif %}
            {% if book.edition_printrun and 'first' in book.edition_printrun | lower %}{% set special_notes = (special_notes.push('First edition'), special_notes) %}{% endif %}
            {{ special_notes | join(', ') or 'None' }}
          </p>
          <p><span class="details-label">Status:</span> <span class="availability-badge available">Available for Viewing</span></p>
        </div>
      </section>
    </div>
  </div>
</div>

</body>
</html>
