<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ book.title }} by {{ book.author_full }} | Hudson Street Library</title>
    {% if book.description %}
<meta name="description" content="{{ book.description | truncate(155) | escape }}">
    {% else %}
<meta name="description" content="{{ book.title }} by {{ book.author_full_name }}. Published by {{ book.publisher }}{% if book.publication_year %} in {{ book.publication_year }}{% endif %}. From the Hudson Street Library collection.">
    {% endif %}
    <link rel="stylesheet" href="/assets/css/design-system.css">
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .details-label {
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            margin-right: 0.5rem;
        }
        .section-heading {
            font-size: 1.25rem;
            font-weight: 600;
            color: #111827;
            margin-bottom: 1.5rem;
            letter-spacing: -0.01em;
        }
        .availability-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 500;
        }
        .availability-badge.available {
            background-color: #D1FAE5;
            color: #065F46;
        }
        .prose {
            line-height: 1.8;
            color: #374151;
            max-width: 70ch;
        }
        .prose p {
            margin-bottom: 1rem;
        }
        .prose a {
            color: #0d9488;
            text-decoration: none;
            border-bottom: 1px solid #0d948844;
        }
        .prose a:hover {
            color: #115e59;
            border-bottom-color: #115e59;
        }
    </style>
    <script>
        // Auto-linkify URLs in notes section
        document.addEventListener('DOMContentLoaded', function() {
            const notesSection = document.querySelector('.notes-content');
            if (notesSection) {
                const urlRegex = /(https?:\/\/[^\s]+)/g;
                notesSection.innerHTML = notesSection.innerHTML.replace(urlRegex, function(url) {
                    return '<a href="' + url + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
                });
            }
        });
    </script>
    {% include "components/schema-organization.njk" %}
    {% include "components/schema-book.njk" %}
    {% include "components/schema-breadcrumb.njk" %}
</head>
<body class="min-h-screen bg-neutral-50">

{% include "components/site-header.njk" %}

<div class="book-page-container max-w-7xl mx-auto px-6 md:px-8 lg:px-12 py-16">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
    <!-- Left Column: Image Only -->
    <div class="lg:col-span-4">
      <!-- Book Cover Image -->
      {% set coverPath = book | generateCoverPath %}
      <div class="book-cover-container lg:sticky lg:top-24">
        <img
          src="{{ coverPath }}"
          alt="Cover of {{ book.title }}"
          class="w-full max-w-xs mx-auto lg:mx-0 h-auto object-contain bg-white rounded-lg shadow-xl border border-neutral-200"
          onerror="this.onerror=null; this.src='/assets/images/placeholder-book.svg'; this.classList.add('opacity-50');"
        />
      </div>
    </div>

    <!-- Right Column: Title, Author, Description, Details, etc. -->
    <div class="lg:col-span-8">
      <!-- Title and Author -->
      <header class="mb-12">
        <h1 class="serif text-3xl font-normal text-gray-900 mb-3 tracking-tight leading-tight">{{ book.title or 'Untitled' }}</h1>
        <p class="text-xl text-gray-600 font-light">
          by
          {% if book.artist_url %}
            <a href="{{ book.artist_url }}" target="_blank" class="text-teal-700 hover:text-teal-900" style="text-decoration: none; border-bottom: 1px solid rgba(13, 148, 136, 0.3);">{{ book.author_full_name or 'Unknown Author' }}</a>
          {% else %}
            {{ book.author_full_name or 'Unknown Author' }}
          {% endif %}
        </p>
      </header>

      <!-- Description -->
      <section class="mb-16">
        <h2 class="section-heading">Description</h2>
        <div class="prose mb-10">
          {{ book.description | safe or '<p>No description available.</p>' }}
        </div>

        <!-- Details (moved under description) -->
        <div class="mt-12 pt-10 border-t border-gray-200" style="border-color: rgba(0, 0, 0, 0.06);">
          <h3 class="text-sm font-semibold text-gray-500 mb-5 uppercase tracking-wider">Details</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-2.5 text-sm">
            {% if book.is_signed_inscribed == 'true' or book.is_signed_inscribed == '1' %}
              <p><span class="details-label">Signed:</span> Yes</p>
            {% endif %}
            <p><span class="details-label">Publisher:</span>
              {% if book.publisher_url %}
                <a href="{{ book.publisher_url }}" target="_blank" class="text-teal-700 hover:text-teal-900 underline">{{ book.publisher or 'Not specified' }}</a>
              {% else %}
                {{ book.publisher or 'Not specified' }}
              {% endif %}
            </p>
            <p><span class="details-label">Published:</span> {{ book.publication_year or 'Not specified' }}</p>
            <p><span class="details-label">ISBN:</span> {{ book.isbn_asin or 'Not specified' }}</p>
            <p><span class="details-label">Format:</span> {{ book.binding or 'Not specified' }}</p>
            <p><span class="details-label">Pages:</span> {{ book.page_count or 'Not specified' }}</p>
            {% if book.num_images %}<p><span class="details-label">Images:</span> {{ book.num_images }}</p>{% endif %}
            <p><span class="details-label">Dimensions:</span>
              {% if book.height_cm and book.width_cm %}
                {{ book.height_cm }}cm × {{ book.width_cm }}cm
                {% if book.depth_cm %} × {{ book.depth_cm }}cm{% endif %}
              {% else %}
                Not specified
              {% endif %}
            </p>
            {% if book.weight_g %}<p><span class="details-label">Weight:</span> {{ book.weight_g }}g</p>{% endif %}
            {% if book.language %}<p><span class="details-label">Language:</span> {{ book.language }}</p>{% endif %}
            {% if book.edition_printrun %}<p><span class="details-label">Edition:</span> {{ book.edition_printrun }}</p>{% endif %}
            {% if book.price %}<p><span class="details-label">Price:</span> {{ book.price }}</p>{% endif %}
          </div>
        </div>
      </section>

      <!-- Notes (for non-uniform information) -->
      {% if book.notes %}
        <section class="mb-16">
          <h2 class="section-heading">Notes</h2>
          <div class="notes-content prose text-sm text-gray-700" style="white-space: pre-line;">{{ book.notes }}</div>
        </section>
      {% endif %}

      <!-- Contributors -->
      {% if book.editor or book.contributors or book.designer %}
        <section class="mb-8">
          <h2 class="section-heading">Contributors</h2>
          <div class="space-y-2 text-sm">
            {% if book.editor %}<p><span class="details-label">Editor:</span> {{ book.editor }}</p>{% endif %}
            {% if book.contributors %}<p><span class="details-label">Contributors:</span> {{ book.contributors }}</p>{% endif %}
            {% if book.designer %}<p><span class="details-label">Designer:</span> {{ book.designer }}</p>{% endif %}
          </div>
        </section>
      {% endif %}

      <!-- Tags & Classification -->
      {% if book.tags or book.classification %}
        <section class="mb-8">
          <h2 class="section-heading">Tags & Classification</h2>

          {% if book.tags %}
            <div class="mb-4">
              <h3 class="details-label mb-2">Tags</h3>
              <p class="text-sm text-gray-600">
                {% set tag_list = book.tags.split(',') %}
                {% for tag in tag_list %}<a href="/static-demo/?tag={{ tag.trim() | urlencode }}" class="text-teal-700 hover:text-teal-900" style="text-decoration: none; border-bottom: 1px solid rgba(13, 148, 136, 0.3);">{{ tag.trim() }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
            </div>
          {% endif %}

          {% if book.classification %}
            <div class="mb-4">
              <h3 class="details-label mb-2">Classification</h3>
              <p class="text-sm text-gray-600">{{ book.classification }}</p>
            </div>
          {% endif %}

          {% if book.collection_grouping %}
            <div>
              <h3 class="details-label mb-2">Collections</h3>
              <p class="text-sm text-gray-600">{{ book.collection_grouping }}</p>
            </div>
          {% endif %}
        </section>
      {% endif %}

      <!-- Library Information -->
      <section class="mb-16">
        <h2 class="section-heading">Library Information</h2>
        <div class="space-y-2 text-sm">
          <p><span class="details-label">Location:</span> {{ book.location or 'Hudson Street Library, NYC' }}</p>
          <p><span class="details-label">Acquired:</span> {{ book.accession_no or 'Original Collection' }}</p>
        </div>
      </section>
    </div>
  </div>

  <!-- Other Books by Same Author -->
  {% set authorBooks = books | otherBooksByAuthor(book.author_last, book.id) %}
  {% set totalByAuthor = books | countByAuthor(book.author_last, book.id) %}

  {% if authorBooks.length > 0 %}
  <section class="mt-20 border-t pt-16" style="border-color: rgba(0, 0, 0, 0.06);">
    <h2 class="text-xl font-semibold text-gray-900 mb-10 tracking-tight">More by {{ book.author_full_name }}</h2>
    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-8 gap-4">
      {% for otherBook in authorBooks %}
      <a href="/books/{{ otherBook.author_last | slugify }}_{{ otherBook.title | slugify }}_{{ otherBook.id }}/" class="group">
        <div class="aspect-[3/4] bg-gray-100 rounded-md overflow-hidden mb-2 shadow-md">
          {% set otherCoverPath = otherBook | generateCoverPath %}
          <img
            src="{{ otherCoverPath }}"
            alt="{{ otherBook.title }}"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
            onerror="this.onerror=null; this.src='/assets/images/placeholder-book.svg'; this.classList.add('opacity-50');"
          />
        </div>
        <h3 class="text-sm font-medium text-gray-800 group-hover:text-teal-700 line-clamp-2">{{ otherBook.title }}</h3>
        {% if otherBook.publication_year %}
        <p class="text-xs text-gray-500">{{ otherBook.publication_year }}</p>
        {% endif %}
      </a>
      {% endfor %}
    </div>
    {% if totalByAuthor > 12 %}
    <p class="mt-8 text-sm text-gray-600">
      <a href="/static-demo/?author={{ book.author_last | urlencode }}" class="text-teal-700 hover:text-teal-900" style="text-decoration: none; border-bottom: 1px solid rgba(13, 148, 136, 0.3);">
        View all {{ totalByAuthor }} books by {{ book.author_full_name }} →
      </a>
    </p>
    {% endif %}
  </section>
  {% endif %}
</div>

</body>
</html>
