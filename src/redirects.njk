---json
{
  "pagination": { "data": "redirects", "size": 1, "alias": "redirect" },
  "permalink": "{{ redirect.out }}",
  "eleventyExcludeFromCollections": true
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Moved &middot; Hudson Street Library</title>
  <meta http-equiv="refresh" content="0; url={{ redirect.to }}">
  <link rel="canonical" href="https://hudsonstreetlibrary.com{{ redirect.to }}">
  <link rel="stylesheet" href="/assets/css/tailwind.css">
  <script>location.replace("{{ redirect.to }}");</script>
</head>
<body>
  <p style="font-family: Literata, Georgia, serif; margin: 4rem auto; max-width: 32rem; text-align: center;">
    This page has moved to <a href="{{ redirect.to }}">{{ redirect.to }}</a>.
  </p>
</body>
</html>
